--indent 4
--indentcase false
--trimwhitespace always
--voidtype void
--stripunusedargs closure-only
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced
--commas inline
--decimalgrouping 3
--elseposition same-line
--guardelse next-line
--header ignore
--ifdef no-indent
--importgrouping alpha
--linebreaks lf
--self remove
--semicolons never
--swiftversion 5.9

--exclude build

# trailing commas are swiftlint's call, so the two tools never fight over them
--disable trailingCommas
--disable wrapMultilineStatementBraces
