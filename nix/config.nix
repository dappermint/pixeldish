# builds /etc/pixeldish/config.kyaml and runs the app's own --check over it, so a
# misspelt shape, palette or param fails the system build instead of falling back
{
  lib,
  runCommand,
  writeText,
  package,
}:
{
  settings ? { },
  pattern ? null,
  saved ? [ ],
}:
let
  toKYAML = import ./kyaml.nix { inherit lib; };
  clean = lib.filterAttrs (_: v: v != null && v != { });
  # a string is a pattern copied from the app ({ ... }) or the id of a saved one
  entry =
    p:
    if builtins.isString p then
      (if lib.hasPrefix "{" (lib.trim p) then { __raw = lib.trim p; } else p)
    else
      clean p;
  doc = clean {
    settings = clean settings;
    pattern = if pattern == null then null else entry pattern;
    saved = if saved == [ ] then null else map entry saved;
  };
  text = writeText "pixeldish-config.kyaml" ("# generated by the pixeldish nix-darwin module\n" + toKYAML doc + "\n");
in
runCommand "pixeldish-config.kyaml" { } ''
  ${package}/Applications/Pixeldish.app/Contents/MacOS/Pixeldish --check ${text}
  cp ${text} $out
''
